{%- comment -%}
  ul-pdp-overrides — style carrier for the product page. Renders the brand tokens
  and a set of LIGHT, scoped overrides that lift the EXISTING product-information
  section to the brand design system (type, color, spacing, button + accordion
  polish). It does NOT touch product-information.liquid and changes no markup;
  every selector is scoped under .product-information so it cannot leak to
  homepage product cards. Uses an inline <style> intentionally (it styles classes
  owned by the theme's product section, not this file's own markup).
{%- endcomment -%}
{% render 'ul-tokens' %}

<style>
  /* --- Spacing / rhythm --- */
  .product-information {
    padding-block: clamp(24px, 4vw, 56px);
  }
  /* Gap between media and info via info-column padding (the theme grid uses fixed
     gutter columns, so a column-gap overflows). Stays inside the column -> no overflow. */
  @media (min-width: 750px) {
    .product-information .product-details {
      padding-inline-start: clamp(20px, 2.4vw, 44px);
    }
  }

  /* Tighten the buy-box vertical rhythm. The block's `gap` setting kept reverting
     when the merchant saved in the editor, so it's forced here (durable). Compounding
     margins on the added blocks are zeroed so the gap stays consistent. */
  .product-information .product-details {
    gap: 16px !important;
    row-gap: 16px !important;
  }
  .product-information .ul-giving { margin-block: 0 !important; }
  .product-information .payment-icons { padding-block: 0 !important; }

  /* --- Typography: brand display on title + section/accordion headings --- */
  .product-information .product-details h1,
  .product-information .product-details h2 {
    font-family: var(--ul-font-display);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.01em;
  }
  .product-information .product-details h1 {
    font-size: clamp(1.9rem, 3vw, 2.7rem);
  }

  /* --- Price --- */
  .product-information .price {
    font-family: var(--ul-font-body);
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: 0.01em;
  }
  .product-information .price-item--sale { color: var(--ul-oxblood); }
  .product-information .compare-at-price { opacity: 0.6; }

  /* --- Variant option buttons / swatches --- */
  .product-information .variant-option__button-label {
    border-radius: var(--ul-radius);
    font-family: var(--ul-font-body);
    letter-spacing: 0.01em;
  }
  .product-information .variant-option__button-label:hover {
    border-color: rgb(var(--ul-brass-rgb) / 0.7);
  }
  .product-information .variant-option input:checked + .variant-option__button-label,
  .product-information .variant-option__button-label.is-selected {
    border-color: var(--ul-brass);
    box-shadow: inset 0 0 0 1px var(--ul-brass);
  }

  /* --- Add-to-cart button → bold OXBLOOD so it stands out (both main + sticky).
     Targets .add-to-cart-button (the class on both) because the main button uses the
     theme's secondary/primary scheme style otherwise (the muted grey). --- */
  .product-information .add-to-cart-button:not(.shopify-payment-button__button),
  .sticky-add-to-cart__button.add-to-cart-button {
    background: var(--ul-oxblood) !important;
    color: #fff !important;
    border: 1.5px solid var(--ul-oxblood) !important;
    border-radius: var(--ul-radius);
    font-family: var(--ul-font-body);
    font-weight: 600;
    letter-spacing: 0.03em;
    transition: background-color 0.35s var(--ul-ease), transform 0.45s var(--ul-ease);
  }
  .product-information .add-to-cart-button:not(.shopify-payment-button__button):hover,
  .sticky-add-to-cart__button.add-to-cart-button:hover {
    background: color-mix(in srgb, var(--ul-oxblood) 86%, black) !important;
    transform: translateY(-1px);
  }
  .product-information .add-to-cart-button[disabled],
  .product-information .add-to-cart-button:disabled {
    background: rgb(var(--ul-espresso-rgb) / 0.3) !important;
    color: rgb(255 255 255 / 0.85) !important;
    transform: none;
  }

  /* --- Accordion (details/care/shipping) --- */
  .product-information .details__header {
    font-family: var(--ul-font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0;
    padding-block: 16px;
  }
  .product-information .details-content {
    font-family: var(--ul-font-body);
    line-height: 1.6;
    color: rgb(var(--ul-espresso-rgb) / 0.86);
  }

  /* --- Gallery polish --- */
  .product-information__media img {
    border-radius: var(--ul-radius);
  }


  /* --- Remove the Essential app's duplicate sticky cart on the PDP; keep the theme's native sticky add-to-cart --- */
  #sticky-cart-portal,
  [data-essential-cart-element="essential-sticky-cart-container"] {
    display: none !important;
  }

  /* --- Sticky ATC layout fix: my buy-box .price size (1.3rem) was bleeding into the
     compact sticky bar and overlapping the variant. Reset it to a small, contained size
     (fixes desktop + mobile). --- */
  .sticky-add-to-cart__price,
  .sticky-add-to-cart__price .price,
  .sticky-add-to-cart__price .price-item {
    font-size: 0.95rem !important;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.2;
  }
  .sticky-add-to-cart__price {
    flex-shrink: 0;
    text-align: right;
  }
  .sticky-add-to-cart__info { min-width: 0; }
  @media screen and (max-width: 749px) {
    .sticky-add-to-cart__price,
    .sticky-add-to-cart__price .price,
    .sticky-add-to-cart__price .price-item {
      font-size: 0.82rem !important;
    }
  }

</style>
{% schema %}
{
  "name": "UL PDP polish",
  "tag": "div",
  "class": "ul-pdp-overrides",
  "settings": [
    { "type": "paragraph", "content": "Applies the Unashamed Living brand styling to the product page (type, color, button, accordion polish). Keep this near the top of the product template. No visible content." }
  ],
  "presets": [ { "name": "UL PDP polish" } ]
}
{% endschema %}
