{% render 'ul-tokens' %}

{%- liquid
  assign s = section.settings
  assign has_image = false
  if s.image != blank
    assign has_image = true
  endif
  assign img_d = s.image
  assign img_m = s.image_mobile | default: s.image
  assign mobile_widths_arr = '440, 640, 840, 1080' | split: ', '
  assign color_mode = s.color_mode | default: 'bone'
-%}

<div
  class="ul-newsletter ul-newsletter-{{ section.id }} ul-newsletter--mode-{{ color_mode }}{% if has_image %} ul-newsletter--has-image{% endif %}"
  style="
    --ul-nl-pad-top: {{ s.padding_top }}px;
    --ul-nl-pad-bot: {{ s.padding_bottom }}px;
    --ul-nl-overlay: {{ s.overlay_opacity | divided_by: 100.0 }};
  "
>
  {%- if has_image -%}
    <div class="ul-newsletter__media" aria-hidden="true">
      <picture>
        {%- if img_m != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{% for w in mobile_widths_arr %}{{ img_m | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
            sizes="100vw"
            width="{{ img_m.width }}"
            height="{{ img_m.height }}"
          >
        {%- endif -%}
        {{
          img_d
          | image_url: width: 2400
          | image_tag:
            widths: '900, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            width: img_d.width,
            height: img_d.height,
            class: 'ul-newsletter__img',
            loading: 'lazy',
            alt: s.image_alt | default: ''
        }}
      </picture>
      <div class="ul-newsletter__scrim" aria-hidden="true"></div>
    </div>
  {%- endif -%}

  <div class="ul-newsletter__inner ul-container">
    <div class="ul-newsletter__content">

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            {%- if block.settings.text != blank -%}
              <p class="ul-eyebrow ul-newsletter__eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {%- endif -%}
          {%- when 'heading' -%}
            {%- if block.settings.text != blank -%}
              <h2 class="ul-newsletter__heading" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
            {%- endif -%}
          {%- when 'subheading' -%}
            {%- if block.settings.text != blank -%}
              <p class="ul-newsletter__sub" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}

      {%- form 'customer', id: 'ul-newsletter-form-{{ section.id }}', class: 'ul-newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">

        {%- if form.posted_successfully? -%}
          <p class="ul-newsletter__success" role="status">{{ s.success_text | default: 'Thank you for subscribing.' }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <div class="ul-newsletter__errors" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="ul-newsletter__row">
            <label class="ul-newsletter__label" for="ul-nl-email-{{ section.id }}">{{ s.placeholder_text | default: 'Enter your email' }}</label>
            <input
              class="ul-newsletter__input"
              id="ul-nl-email-{{ section.id }}"
              type="email"
              name="contact[email]"
              autocomplete="email"
              placeholder="{{ s.placeholder_text | default: 'Enter your email' }}"
              required
              aria-label="{{ s.placeholder_text | default: 'Enter your email' }}"
            >
            <button type="submit" class="ul-btn ul-btn--primary ul-newsletter__submit">
              {{ s.button_label | default: 'Subscribe' }}
            </button>
          </div>

          {%- if s.fineprint != blank -%}
            <p class="ul-newsletter__fineprint">{{ s.fineprint }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}

    </div>
  </div>
</div>

{% stylesheet %}
  .ul-newsletter {
    position: relative;
    isolation: isolate;
    padding-block: var(--ul-nl-pad-top, 112px) var(--ul-nl-pad-bot, 112px);
    background: var(--ul-bone);
    color: var(--ul-espresso);
  }

  .ul-newsletter--mode-white {
    background: #ffffff;
    color: var(--ul-espresso);
  }

  .ul-newsletter--mode-dark {
    background: var(--ul-espresso);
    color: var(--ul-bone);
  }

  .ul-newsletter--has-image {
    background: var(--ul-dark);
    color: var(--ul-bone);
  }

  /* Background image */
  .ul-newsletter__media,
  .ul-newsletter__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ul-newsletter__img {
    object-fit: cover;
    object-position: center center;
  }

  .ul-newsletter__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgb(var(--ul-espresso-rgb) / var(--ul-nl-overlay, 0.4));
  }

  /* Inner layout */
  .ul-newsletter__inner {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
  }

  .ul-newsletter__content {
    width: 100%;
    max-width: 620px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(12px, 1.6vw, 20px);
  }

  /* Eyebrow */
  .ul-newsletter__eyebrow {
    color: var(--ul-brass);
  }

  .ul-newsletter--has-image .ul-newsletter__eyebrow,
  .ul-newsletter--mode-dark .ul-newsletter__eyebrow {
    color: color-mix(in srgb, var(--ul-brass) 78%, white);
  }

  /* Heading */
  .ul-newsletter__heading {
    font-family: var(--ul-font-display);
    font-weight: 700;
    font-size: var(--ul-fs-h2);
    line-height: 1.06;
    letter-spacing: -0.01em;
    margin: 0;
    text-wrap: balance;
  }

  /* Subheading */
  .ul-newsletter__sub {
    font-family: var(--ul-font-body);
    font-size: clamp(1rem, 1.2vw, 1.1rem);
    line-height: 1.6;
    margin: 0;
    max-width: 50ch;
    opacity: 0.88;
  }

  /* Form */
  .ul-newsletter__form {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: clamp(6px, 1vw, 12px);
  }

  .ul-newsletter__row {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 10px;
  }

  /* Visually-hidden label — accessible, not visible */
  .ul-newsletter__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .ul-newsletter__input {
    width: 100%;
    min-height: 52px;
    padding: 0 18px;
    border-radius: var(--ul-radius);
    border: 1.5px solid rgb(var(--ul-espresso-rgb) / 0.22);
    background: rgb(255 255 255 / 0.92);
    color: var(--ul-espresso);
    font-family: var(--ul-font-body);
    font-size: 1rem;
    transition: border-color 0.25s var(--ul-ease);
    appearance: none;
    -webkit-appearance: none;
  }

  .ul-newsletter--mode-dark .ul-newsletter__input,
  .ul-newsletter--has-image .ul-newsletter__input {
    border-color: rgb(var(--ul-bone-rgb) / 0.3);
    background: rgb(255 255 255 / 0.1);
    color: var(--ul-bone);
  }

  .ul-newsletter--mode-dark .ul-newsletter__input::placeholder,
  .ul-newsletter--has-image .ul-newsletter__input::placeholder {
    color: rgb(var(--ul-bone-rgb) / 0.55);
  }

  .ul-newsletter__input:focus-visible {
    outline: 2px solid var(--ul-brass);
    outline-offset: 2px;
    border-color: var(--ul-brass);
  }

  .ul-newsletter__submit {
    width: 100%;
    flex-shrink: 0;
  }

  /* Fine print */
  .ul-newsletter__fineprint {
    font-family: var(--ul-font-body);
    font-size: var(--ul-fs-small);
    line-height: 1.5;
    margin: 0;
    opacity: 0.55;
    max-width: 48ch;
    text-align: center;
  }

  /* Success message */
  .ul-newsletter__success {
    font-family: var(--ul-font-body);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.5;
    margin: 0;
    color: var(--ul-brass);
    padding: 18px 0 4px;
  }

  /* Error message */
  .ul-newsletter__errors {
    width: 100%;
    font-family: var(--ul-font-body);
    font-size: 0.88rem;
    color: var(--ul-oxblood);
    background: rgb(var(--ul-oxblood-rgb) / 0.08);
    border: 1px solid rgb(var(--ul-oxblood-rgb) / 0.25);
    border-radius: var(--ul-radius);
    padding: 10px 14px;
    text-align: left;
  }

  .ul-newsletter--has-image .ul-newsletter__errors,
  .ul-newsletter--mode-dark .ul-newsletter__errors {
    color: #ffc5c5;
    background: rgb(255 100 100 / 0.1);
    border-color: rgb(255 100 100 / 0.25);
  }

  /* Buttons */
  .ul-newsletter .ul-btn {
    --ul-btn-bg: var(--ul-brass);
    --ul-btn-fg: var(--ul-espresso);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    min-height: 52px;
    padding: 0 32px;
    border-radius: var(--ul-radius);
    font-family: var(--ul-font-body);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    cursor: pointer;
    border: 1.5px solid transparent;
    background: var(--ul-btn-bg);
    color: var(--ul-btn-fg);
    transition: transform 0.45s var(--ul-ease), background-color 0.35s var(--ul-ease), color 0.35s var(--ul-ease);
  }

  .ul-newsletter .ul-btn:hover {
    transform: translateY(-2px);
  }

  .ul-newsletter .ul-btn--primary {
    --ul-btn-bg: var(--ul-brass);
    --ul-btn-fg: #fff;
  }

  .ul-newsletter .ul-btn--primary:hover {
    --ul-btn-bg: color-mix(in srgb, var(--ul-brass) 84%, black);
  }

  .ul-newsletter .ul-btn:focus-visible {
    outline: 2px solid var(--ul-brass);
    outline-offset: 3px;
  }

  /* Scroll-reveal for the content block */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .ul-newsletter__content {
        opacity: 0;
        transform: translateY(26px);
        animation: ul-newsletter-reveal linear both;
        animation-timeline: view();
        animation-range: entry 2% cover 22%;
      }
    }
  }
  @keyframes ul-newsletter-reveal {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Desktop: inline row (input + button side-by-side) */
  @media (min-width: 600px) {
    .ul-newsletter__row {
      flex-direction: row;
      align-items: stretch;
    }

    .ul-newsletter__input {
      flex: 1 1 auto;
      min-width: 0;
      border-radius: var(--ul-radius) 0 0 var(--ul-radius);
    }

    .ul-newsletter__submit {
      width: auto;
      flex-shrink: 0;
      border-radius: 0 var(--ul-radius) var(--ul-radius) 0;
    }
  }

  /* ul-mobile-pad: scale section padding down on mobile for balanced spacing */
  @media (max-width: 749px) {
    .ul-newsletter {
      padding-block: max(40px, calc(var(--ul-nl-pad-top, 112px) * 0.55)) max(40px, calc(var(--ul-nl-pad-bot, 112px) * 0.55));
    }
  }

  /* Ensure <picture> fills its frame so object-fit:cover applies (no dead space) */
  .ul-newsletter picture {
    display: block;
    width: 100%;
    height: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "UL Newsletter",
  "tag": "section",
  "class": "ul-newsletter-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "select",
      "id": "color_mode",
      "label": "Section background",
      "info": "Only visible when no background image is set.",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "bone", "label": "Bone (warm light)" },
        { "value": "dark", "label": "Dark (espresso)" }
      ],
      "default": "white"
    },
    {
      "type": "header",
      "content": "Background image (optional)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Falls back to the desktop image if empty."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text (accessibility)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay darkness",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 40,
      "info": "Only applies when a background image is set."
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Welcome to the movement. Check your inbox."
    },
    {
      "type": "text",
      "id": "fineprint",
      "label": "Fine print",
      "default": "By subscribing you agree to receive emails. Unsubscribe anytime."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 112
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Eyebrow text"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Subheading"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UL Newsletter",
      "settings": {
        "color_mode": "bone",
        "button_label": "Subscribe",
        "placeholder_text": "Enter your email",
        "success_text": "Welcome to the movement. Check your inbox.",
        "fineprint": "By subscribing you agree to receive emails. Unsubscribe anytime.",
        "padding_top": 112,
        "padding_bottom": 112,
        "overlay_opacity": 40
      },
      "blocks": [
        { "type": "eyebrow", "settings": { "text": "Stay unashamed" } },
        { "type": "heading", "settings": { "text": "Join the movement" } },
        { "type": "subheading", "settings": { "text": "Scripture-rooted drops, giving updates, and early access. No noise — just the mission." } }
      ]
    }
  ]
}
{% endschema %}
