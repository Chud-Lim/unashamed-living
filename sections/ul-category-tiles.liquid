{%- comment -%}
  ul-category-tiles — 3-up portrait category tiles (Apparel / Jewelry / Home Decor).
  Mejuri-style on-model imagery with bottom gradient scrim, label overlaid, hover
  brass underline. Mobile: horizontal scroll-snap (optional). Desktop: CSS grid.
  Separate eyebrow / heading blocks for merchant flexibility.
  All CSS scoped under .ul-category-tiles. Per-instance values via inline custom props.
{%- endcomment -%}
{% render 'ul-tokens' %}

{%- liquid
  assign s = section.settings
  assign cols = s.columns_desktop | default: 3
  assign mobile_scroll = s.mobile_carousel
  assign color_mode = s.color_mode | default: 'bone'
  assign header_align = s.header_alignment | default: 'left'
  assign pad_top = s.padding_top | default: 96
  assign pad_bot = s.padding_bottom | default: 96
  assign mobile_widths_arr = '440, 640, 840' | split: ', '
  assign tile_sizes = '(min-width: 750px) calc((100vw - 2 * var(--ul-pad-inline)) / ' | append: cols | append: '), 78vw'
-%}

<div
  class="ul-category-tiles ul-category-tiles-{{ section.id }} ul-category-tiles--{{ color_mode }}{% if mobile_scroll %} ul-category-tiles--mobile-scroll{% endif %}"
  style="
    --ul-ct-cols: {{ cols }};
    --ul-ct-pad-top: {{ pad_top }}px;
    --ul-ct-pad-bot: {{ pad_bot }}px;
  "
>
  {%- comment -%} Section header (eyebrow + heading blocks) {%- endcomment -%}
  {%- assign header_blocks = section.blocks | where: 'type', 'eyebrow' -%}
  {%- assign heading_blocks = section.blocks | where: 'type', 'heading' -%}
  {%- if header_blocks.size > 0 or heading_blocks.size > 0 -%}
    <div class="ul-category-tiles__header ul-container ul-category-tiles__header--{{ header_align }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <p class="ul-eyebrow ul-category-tiles__eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
          {%- when 'heading' -%}
            <h2 class="ul-category-tiles__heading" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} Tile grid {%- endcomment -%}
  <div class="ul-category-tiles__grid ul-container" role="list">
    {%- for block in section.blocks -%}
      {%- if block.type != 'tile' -%}{%- continue -%}{%- endif -%}
      {%- liquid
        assign bs = block.settings
        assign tile_link = bs.link | default: '#'
        assign tile_label = bs.label
        assign tile_sublabel = bs.sublabel
        assign tile_alt = bs.image_alt | default: tile_label
        assign tile_img = bs.image
        assign tile_img_m = bs.image_mobile
        assign tile_col = bs.collection
        assign img_src = nil
        assign img_src_m = nil
        if tile_img != blank
          assign img_src = tile_img
          assign img_src_m = tile_img_m
        elsif tile_col != blank and tile_col.featured_image != blank
          assign img_src = tile_col.featured_image
        elsif tile_col != blank and tile_col.products.first != blank
          assign img_src = tile_col.products.first.featured_media
        endif
      -%}
      <a
        class="ul-category-tiles__tile"
        href="{{ tile_link }}"
        aria-label="{{ tile_label }}"
        role="listitem"
        {{ block.shopify_attributes }}
      >
        <div class="ul-category-tiles__tile-media" aria-hidden="true">
          {%- if img_src != blank -%}
            <picture>
              {%- if img_src_m != blank -%}
                <source
                  media="(max-width: 749px)"
                  srcset="{% for w in mobile_widths_arr %}{{ img_src_m | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
                  sizes="{{ tile_sizes }}"
                  width="{{ img_src_m.width }}"
                  height="{{ img_src_m.height }}"
                >
              {%- endif -%}
              {{
                img_src
                | image_url: width: 960
                | image_tag:
                  widths: '480, 640, 800, 960',
                  sizes: tile_sizes,
                  width: img_src.width,
                  height: img_src.height,
                  alt: tile_alt,
                  class: 'ul-category-tiles__img',
                  loading: 'lazy'
              }}
            </picture>
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'ul-category-tiles__img ul-category-tiles__img--placeholder' }}
          {%- endif -%}
          <div class="ul-category-tiles__scrim" aria-hidden="true"></div>
        </div>

        <div class="ul-category-tiles__label-wrap">
          <span class="ul-category-tiles__label">{{ tile_label }}</span>
          {%- if tile_sublabel != blank -%}
            <span class="ul-category-tiles__sublabel">{{ tile_sublabel }}</span>
          {%- endif -%}
          <span class="ul-category-tiles__underline" aria-hidden="true"></span>
        </div>
      </a>
    {%- else -%}
      {%- comment -%} No tile blocks: render nothing {%- endcomment -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  /* ── ul-category-tiles ──────────────────────────────────────────────────── */
  .ul-category-tiles {
    padding-block: var(--ul-ct-pad-top, 96px) var(--ul-ct-pad-bot, 96px);
    background: var(--ul-bone);
    color: var(--ul-espresso);
  }

  .ul-category-tiles--dark {
    background: var(--ul-dark);
    color: var(--ul-bone);
  }

  /* Header */
  .ul-category-tiles__header {
    margin-bottom: clamp(32px, 4vw, 52px);
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1vw, 14px);
  }

  .ul-category-tiles__header--center {
    text-align: center;
    align-items: center;
  }

  .ul-category-tiles__header--left {
    text-align: left;
    align-items: flex-start;
  }

  .ul-category-tiles__eyebrow {
    color: var(--ul-brass);
  }

  .ul-category-tiles--dark .ul-category-tiles__eyebrow {
    color: color-mix(in srgb, var(--ul-brass) 85%, white);
  }

  .ul-category-tiles__heading {
    font-family: var(--ul-font-display);
    font-weight: 700;
    font-size: var(--ul-fs-h2);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0;
    text-wrap: balance;
  }

  /* Grid */
  .ul-category-tiles__grid {
    display: grid;
    grid-template-columns: repeat(var(--ul-ct-cols, 3), 1fr);
    gap: var(--ul-gap);
  }

  /* Tile */
  .ul-category-tiles__tile {
    display: block;
    position: relative;
    text-decoration: none;
    color: var(--ul-bone);
    overflow: hidden;
    border-radius: var(--ul-radius);
  }

  .ul-category-tiles__tile-media {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--ul-espresso);
  }

  .ul-category-tiles__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.6s var(--ul-ease);
  }

  .ul-category-tiles__img--placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Bottom gradient scrim for label legibility */
  .ul-category-tiles__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgb(var(--ul-espresso-rgb) / 0.78) 0%,
      rgb(var(--ul-espresso-rgb) / 0.36) 36%,
      rgb(var(--ul-espresso-rgb) / 0) 60%
    );
    pointer-events: none;
  }

  /* Label overlay */
  .ul-category-tiles__label-wrap {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    padding: clamp(20px, 3vw, 32px) clamp(18px, 2.5vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ul-category-tiles__label {
    font-family: var(--ul-font-display);
    font-weight: 700;
    font-size: clamp(1.3rem, 2.2vw, 1.85rem);
    line-height: 1.1;
    color: var(--ul-bone);
    letter-spacing: -0.01em;
  }

  .ul-category-tiles__sublabel {
    font-family: var(--ul-font-body);
    font-size: var(--ul-fs-small);
    font-weight: 600;
    letter-spacing: var(--ul-eyebrow-ls);
    text-transform: uppercase;
    color: var(--ul-brass);
    display: block;
  }

  /* Brass underline — grows from 0 on hover */
  .ul-category-tiles__underline {
    display: block;
    height: 2px;
    width: 0;
    background: var(--ul-brass);
    margin-top: 8px;
    transition: width 0.38s var(--ul-ease);
  }

  /* Hover state */
  .ul-category-tiles__tile:hover .ul-category-tiles__img {
    transform: scale(1.04);
  }

  .ul-category-tiles__tile:hover .ul-category-tiles__underline {
    width: clamp(28px, 3vw, 44px);
  }

  /* Focus visible */
  .ul-category-tiles__tile:focus-visible {
    outline: 2px solid var(--ul-brass);
    outline-offset: 3px;
  }

  /* Mobile: horizontal scroll-snap */
  .ul-category-tiles--mobile-scroll .ul-category-tiles__grid {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 12px;
    scrollbar-width: none;
    gap: var(--ul-gap);
  }

  .ul-category-tiles--mobile-scroll .ul-category-tiles__grid::-webkit-scrollbar {
    display: none;
  }

  .ul-category-tiles--mobile-scroll .ul-category-tiles__tile {
    flex: 0 0 78vw;
    scroll-snap-align: start;
    max-width: 340px;
  }

  /* Scroll-reveal for the tile grid (scoped to this section) */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .ul-category-tiles__grid {
        opacity: 0;
        transform: translateY(26px);
        animation: ul-ct-reveal-in linear both;
        animation-timeline: view();
        animation-range: entry 2% cover 22%;
      }
    }
  }

  @keyframes ul-ct-reveal-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Stagger hover transition delays on tiles */
  @media (prefers-reduced-motion: no-preference) {
    .ul-category-tiles__tile:nth-child(2) .ul-category-tiles__img { transition-delay: 0.04s; }
    .ul-category-tiles__tile:nth-child(3) .ul-category-tiles__img { transition-delay: 0.08s; }
    .ul-category-tiles__tile:nth-child(4) .ul-category-tiles__img { transition-delay: 0.12s; }
  }

  /* Desktop: restore grid, hide scroll chrome */
  @media (min-width: 750px) {
    .ul-category-tiles--mobile-scroll .ul-category-tiles__grid {
      display: grid;
      grid-template-columns: repeat(var(--ul-ct-cols, 3), 1fr);
      overflow-x: visible;
      flex-wrap: wrap;
      padding-bottom: 0;
    }

    .ul-category-tiles--mobile-scroll .ul-category-tiles__tile {
      flex: unset;
      max-width: unset;
    }
  }

  /* ul-mobile-pad: scale section padding down on mobile for balanced spacing */
  @media (max-width: 749px) {
    .ul-category-tiles {
      padding-block: max(40px, calc(var(--ul-ct-pad-top, 96px) * 0.55)) max(40px, calc(var(--ul-ct-pad-bot, 96px) * 0.55));
    }
  }

  /* Ensure <picture> fills its frame so object-fit:cover applies (no dead space) */
  .ul-category-tiles picture {
    display: block;
    width: 100%;
    height: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "UL Categories",
  "tag": "section",
  "class": "ul-category-tiles-section",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "mobile_carousel",
      "label": "Mobile horizontal scroll",
      "info": "Tiles scroll horizontally at ~78vw on mobile. Uncheck to stack.",
      "default": true
    },
    { "type": "header", "content": "Appearance" },
    {
      "type": "select",
      "id": "color_mode",
      "label": "Section background",
      "options": [
        { "value": "bone", "label": "Bone (light)" },
        { "value": "dark", "label": "Dark (espresso)" }
      ],
      "default": "bone"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Eyebrow text" }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Section heading" }
      ]
    },
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        { "type": "text", "id": "label", "label": "Category label", "info": "Displayed over the image (e.g. Apparel)." },
        { "type": "text", "id": "sublabel", "label": "Sublabel (optional)", "info": "Small uppercase line below the label (e.g. New arrivals)." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "header", "content": "Images" },
        { "type": "image_picker", "id": "image", "label": "Desktop image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Falls back to desktop image if empty." },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "info": "Defaults to the category label." },
        { "type": "header", "content": "Collection (auto-fill)" },
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Used as fallback imagery if no image is picked." }
      ]
    }
  ],
  "presets": [
    {
      "name": "UL Categories",
      "settings": {
        "columns_desktop": 3,
        "mobile_carousel": true,
        "color_mode": "bone",
        "header_alignment": "left",
        "padding_top": 96,
        "padding_bottom": 96
      },
      "blocks": [
        {
          "type": "eyebrow",
          "settings": { "text": "Shop by category" }
        },
        {
          "type": "heading",
          "settings": { "text": "Find your everyday witness" }
        },
        {
          "type": "tile",
          "settings": {
            "label": "Apparel",
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "tile",
          "settings": {
            "label": "Jewelry",
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "tile",
          "settings": {
            "label": "Home Decor",
            "link": "shopify://collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}
