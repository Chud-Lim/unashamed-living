{%- comment -%}
  ul-hero — full-bleed cinematic homepage hero.
  Separate desktop/mobile image_picker served via <picture>. Text content as
  blocks (eyebrow / heading / subheading / button) for merchant flexibility.
  All CSS scoped under .ul-hero (a unique ul- class, so it cannot leak).
  Per-instance values are passed as inline --ul-hero-* custom properties.
{%- endcomment -%}
{% render 'ul-tokens' %}

{%- liquid
  assign s = section.settings
  assign img_d = s.image
  assign img_m = s.image_mobile | default: s.image
  assign sizes = '100vw'
  assign widths = '600, 900, 1200, 1600, 2000, 2600, 3200'
  assign mobile_widths_arr = '440, 640, 840, 1080, 1320' | split: ', '
-%}

<div
  class="ul-hero ul-hero-{{ section.id }} ul-hero--text-{{ s.text_color }} ul-hero--v-{{ s.content_vertical }}"
  style="
    --ul-hero-min: {{ s.height_desktop }}svh;
    --ul-hero-min-mobile: {{ s.height_mobile }}svh;
    --ul-hero-overlay: {{ s.overlay_opacity | divided_by: 100.0 }};
    --ul-hero-scrim: {{ s.scrim_strength | divided_by: 100.0 }};
    --ul-hero-align: {{ s.content_alignment }};
    --ul-hero-maxw: {{ s.content_max_width }}px;
  "
>
  <div class="ul-hero__media">
    {%- if img_d != blank -%}
      <picture>
        {%- if img_m != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{% for w in mobile_widths_arr %}{{ img_m | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
            sizes="{{ sizes }}"
            width="{{ img_m.width }}"
            height="{{ img_m.height }}"
          >
        {%- endif -%}
        {{
          img_d
          | image_url: width: 3200
          | image_tag:
            widths: widths,
            sizes: sizes,
            width: img_d.width,
            height: img_d.height,
            alt: img_d.alt | default: section.settings.image_alt,
            class: 'ul-hero__img',
            fetchpriority: 'high',
            loading: 'eager'
        }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'ul-hero__img ul-hero__img--placeholder' }}
    {%- endif -%}
    <div class="ul-hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="ul-hero__inner ul-container">
    <div class="ul-hero__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <p class="ul-eyebrow ul-hero__eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
          {%- when 'heading' -%}
            <h1 class="ul-hero__heading" {{ block.shopify_attributes }}>{{ block.settings.text }}</h1>
          {%- when 'subheading' -%}
            <p class="ul-hero__sub" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
        {%- endcase -%}
      {%- endfor -%}

      {%- assign buttons = section.blocks | where: 'type', 'button' -%}
      {%- if buttons.size > 0 -%}
        <div class="ul-hero__actions">
          {%- for block in buttons -%}
            {%- if block.settings.label != blank -%}
              <a
                class="ul-btn ul-btn--{{ block.settings.style }}"
                href="{{ block.settings.link | default: '#' }}"
                {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
                {{ block.shopify_attributes }}
              >{{ block.settings.label }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .ul-hero {
    position: relative;
    isolation: isolate;
    min-height: var(--ul-hero-min-mobile, 88svh);
    display: grid;
    overflow: hidden;
    background: var(--ul-dark);
  }

  .ul-hero__media,
  .ul-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ul-hero__img {
    object-fit: cover;
    object-position: center center;
  }

  .ul-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to top, rgb(var(--ul-espresso-rgb) / calc(0.72 * var(--ul-hero-scrim, 1))) 0%, rgb(var(--ul-espresso-rgb) / 0) 52%),
      rgb(var(--ul-espresso-rgb) / var(--ul-hero-overlay, 0.32));
  }

  .ul-hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: var(--ul-hero-v-align, flex-end);
    padding-block: clamp(40px, 8vh, 104px);
    width: 100%;
  }

  .ul-hero--v-center .ul-hero__inner { --ul-hero-v-align: center; }
  .ul-hero--v-bottom .ul-hero__inner { --ul-hero-v-align: flex-end; }

  .ul-hero__content {
    max-width: var(--ul-hero-maxw, 720px);
    text-align: var(--ul-hero-align, left);
    margin-inline: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 1.8vw, 22px);
  }

  .ul-hero[style*="--ul-hero-align: center"] .ul-hero__content,
  .ul-hero--text-light .ul-hero__content { }

  .ul-hero__content:has(.ul-hero__heading[style]) { }

  /* Centered content centers the column too */
  .ul-hero__inner:has(.ul-hero__content[style*="center"]) { justify-content: center; }

  .ul-hero--text-light { color: var(--ul-bone); }
  .ul-hero--text-dark { color: var(--ul-espresso); }

  .ul-hero__eyebrow {
    color: var(--ul-brass);
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
  }

  .ul-hero--text-light .ul-hero__eyebrow { color: color-mix(in srgb, var(--ul-brass) 78%, white); }

  .ul-hero__heading {
    font-family: var(--ul-font-display);
    font-weight: 700;
    font-size: var(--ul-fs-hero);
    line-height: 0.98;
    letter-spacing: -0.01em;
    margin: 0;
    text-wrap: balance;
  }

  .ul-hero__sub {
    font-family: var(--ul-font-body);
    font-size: clamp(1.02rem, 1.4vw, 1.22rem);
    line-height: 1.5;
    margin: 0;
    max-width: 52ch;
    opacity: 0.94;
  }

  .ul-hero[style*="center"] .ul-hero__sub { margin-inline: auto; }

  .ul-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: clamp(6px, 1vw, 14px);
  }

  .ul-hero[style*="center"] .ul-hero__actions { justify-content: center; }

  /* Buttons (shared brand button idiom) */
  .ul-btn {
    --ul-btn-bg: var(--ul-brass);
    --ul-btn-fg: var(--ul-espresso);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    min-height: 52px;
    padding: 0 32px;
    border-radius: var(--ul-radius);
    font-family: var(--ul-font-body);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    cursor: pointer;
    border: 1.5px solid transparent;
    background: var(--ul-btn-bg);
    color: var(--ul-btn-fg);
    transition: transform 0.45s var(--ul-ease), background-color 0.35s var(--ul-ease), color 0.35s var(--ul-ease), border-color 0.35s var(--ul-ease);
  }

  .ul-btn:hover { transform: translateY(-2px); }

  .ul-btn--primary {
    --ul-btn-bg: var(--ul-brass);
    --ul-btn-fg: #fff;
  }
  .ul-btn--primary:hover { --ul-btn-bg: color-mix(in srgb, var(--ul-brass) 84%, black); }

  .ul-btn--secondary {
    --ul-btn-bg: transparent;
    --ul-btn-fg: var(--ul-bone);
    border-color: rgb(var(--ul-bone-rgb) / 0.55);
  }
  .ul-btn--secondary:hover {
    --ul-btn-bg: var(--ul-bone);
    --ul-btn-fg: var(--ul-espresso);
    border-color: var(--ul-bone);
  }

  .ul-hero--text-dark .ul-btn--secondary {
    --ul-btn-fg: var(--ul-espresso);
    border-color: rgb(var(--ul-espresso-rgb) / 0.4);
  }
  .ul-hero--text-dark .ul-btn--secondary:hover {
    --ul-btn-bg: var(--ul-espresso);
    --ul-btn-fg: var(--ul-bone);
  }

  :focus-visible {
    outline-offset: 3px;
  }
  .ul-btn:focus-visible {
    outline: 2px solid var(--ul-bone);
    outline-offset: 3px;
  }

  @media (min-width: 750px) {
    .ul-hero { min-height: var(--ul-hero-min, 92svh); }
  }

  /* Subtle load-in for above-the-fold content (scroll-reveal won't trigger here) */
  @media (prefers-reduced-motion: no-preference) {
    .ul-hero__content > * {
      animation: ul-hero-rise 0.9s var(--ul-ease) both;
    }
    .ul-hero__content > *:nth-child(2) { animation-delay: 0.08s; }
    .ul-hero__content > *:nth-child(3) { animation-delay: 0.16s; }
    .ul-hero__content > *:nth-child(4) { animation-delay: 0.24s; }
  }
  @keyframes ul-hero-rise {
    from { opacity: 0; transform: translateY(22px); }
    to { opacity: 1; transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "UL Hero",
  "tag": "section",
  "class": "ul-hero-section",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Desktop media" },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text (accessibility)" },
    { "type": "header", "content": "Mobile media" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Falls back to the desktop image if empty." },
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "content_alignment", "label": "Text alignment",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ],
      "default": "left"
    },
    {
      "type": "select", "id": "content_vertical", "label": "Vertical position",
      "options": [ { "value": "center", "label": "Center" }, { "value": "bottom", "label": "Bottom" } ],
      "default": "bottom"
    },
    { "type": "range", "id": "content_max_width", "label": "Content width", "min": 480, "max": 900, "step": 20, "unit": "px", "default": 720 },
    { "type": "range", "id": "height_desktop", "label": "Desktop height", "min": 60, "max": 100, "step": 2, "unit": "svh", "default": 92 },
    { "type": "range", "id": "height_mobile", "label": "Mobile height", "min": 60, "max": 100, "step": 2, "unit": "svh", "default": 88 },
    { "type": "header", "content": "Appearance" },
    {
      "type": "select", "id": "text_color", "label": "Text color",
      "options": [ { "value": "light", "label": "Light (on dark image)" }, { "value": "dark", "label": "Dark (on light image)" } ],
      "default": "light"
    },
    { "type": "range", "id": "overlay_opacity", "label": "Overall overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 },
    { "type": "range", "id": "scrim_strength", "label": "Bottom scrim", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Eyebrow", "settings": [ { "type": "text", "id": "text", "label": "Eyebrow" } ] },
    { "type": "heading", "name": "Heading", "settings": [ { "type": "text", "id": "text", "label": "Heading" } ] },
    { "type": "subheading", "name": "Subheading", "settings": [ { "type": "textarea", "id": "text", "label": "Subheading" } ] },
    {
      "type": "button", "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Button label" },
        { "type": "url", "id": "link", "label": "Button link" },
        {
          "type": "select", "id": "style", "label": "Style",
          "options": [ { "value": "primary", "label": "Primary (brass)" }, { "value": "secondary", "label": "Secondary (outline)" } ],
          "default": "primary"
        },
        { "type": "checkbox", "id": "open_in_new_tab", "label": "Open in new tab", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "UL Hero",
      "blocks": [
        { "type": "eyebrow", "settings": { "text": "Faith-forward apparel, jewelry & home" } },
        { "type": "heading", "settings": { "text": "Proclaim Boldly. Live Unashamed." } },
        { "type": "subheading", "settings": { "text": "Wear your faith and fund the Great Commission. 10% of every sale equips churches and communities worldwide." } },
        { "type": "button", "settings": { "label": "Shop the collection", "link": "shopify://collections/all", "style": "primary" } },
        { "type": "button", "settings": { "label": "Our mission", "link": "shopify://collections", "style": "secondary" } }
      ],
      "settings": {
        "content_alignment": "left",
        "content_vertical": "bottom",
        "text_color": "light"
      }
    }
  ]
}
{% endschema %}
