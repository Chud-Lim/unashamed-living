{%- comment -%}
  ul-editorial-story — split lifestyle image + narrative copy (the brand story
  moment, "Together we represent Him"). 50/50 on desktop, stacked on mobile
  (image first). Separate desktop/mobile image_picker served via <picture>.
  Text content as blocks (eyebrow / heading / body / button) for merchant
  flexibility. All CSS scoped under .ul-editorial-story (a unique ul- class, so
  it cannot leak). Per-instance values are passed as inline --ul-es-* props.
{%- endcomment -%}
{% render 'ul-tokens' %}

{%- liquid
  assign s = section.settings
  assign img_d = s.image
  assign img_m = s.image_mobile | default: s.image
  assign sizes = '(min-width: 750px) 50vw, 100vw'
  assign widths = '600, 760, 900, 1100, 1300, 1600, 2000'
  assign mobile_widths_arr = '440, 640, 840, 1080, 1320, 1600' | split: ', '
-%}

<div
  class="ul-editorial-story ul-editorial-story-{{ section.id }} ul-editorial-story--media-{{ s.media_position }} ul-editorial-story--{{ s.color_mode }} ul-editorial-story--ratio-{{ s.image_ratio }}"
  style="
    --ul-es-pad-top: {{ s.padding_top }}px;
    --ul-es-pad-bottom: {{ s.padding_bottom }}px;
  "
>
  <div class="ul-editorial-story__grid">
    <div class="ul-editorial-story__media">
      {%- if img_d != blank -%}
        <picture>
          {%- if img_m != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="{% for w in mobile_widths_arr %}{{ img_m | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
              sizes="{{ sizes }}"
              width="{{ img_m.width }}"
              height="{{ img_m.height }}"
            >
          {%- endif -%}
          {{
            img_d
            | image_url: width: 2000
            | image_tag:
              widths: widths,
              sizes: sizes,
              width: img_d.width,
              height: img_d.height,
              alt: img_d.alt | default: section.settings.image_alt,
              class: 'ul-editorial-story__img ul-reveal',
              loading: 'lazy'
          }}
        </picture>
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'ul-editorial-story__img ul-editorial-story__img--placeholder' }}
      {%- endif -%}
    </div>

    <div class="ul-editorial-story__text ul-container ul-reveal">
      <div class="ul-editorial-story__content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'eyebrow' -%}
              {%- if block.settings.text != blank -%}
                <p class="ul-eyebrow ul-editorial-story__eyebrow" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                  <span class="ul-editorial-story__rule" aria-hidden="true"></span>
                </p>
              {%- endif -%}
            {%- when 'heading' -%}
              {%- if block.settings.text != blank -%}
                <h2 class="ul-editorial-story__heading" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
              {%- endif -%}
            {%- when 'body' -%}
              {%- if block.settings.text != blank -%}
                <div class="ul-editorial-story__body" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}

        {%- assign buttons = section.blocks | where: 'type', 'button' -%}
        {%- if buttons.size > 0 -%}
          <div class="ul-editorial-story__actions">
            {%- for block in buttons -%}
              {%- if block.settings.label != blank -%}
                <a
                  class="ul-btn ul-btn--{{ block.settings.style }} ul-editorial-story__btn"
                  href="{{ block.settings.link | default: '#' }}"
                  {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
                  {{ block.shopify_attributes }}
                >{{ block.settings.label }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .ul-editorial-story {
    background: var(--ul-bone);
    color: var(--ul-espresso);
    padding-block: var(--ul-es-pad-top, 104px) var(--ul-es-pad-bottom, 104px);
  }

  .ul-editorial-story--dark {
    background: var(--ul-dark);
    color: var(--ul-bone);
  }

  .ul-editorial-story__grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  .ul-editorial-story__media {
    position: relative;
    overflow: hidden;
    background: rgb(var(--ul-espresso-rgb) / 0.06);
    aspect-ratio: var(--ul-es-ratio, 4 / 5);
  }

  .ul-editorial-story--dark .ul-editorial-story__media {
    background: rgb(var(--ul-bone-rgb) / 0.06);
  }

  .ul-editorial-story--ratio-portrait .ul-editorial-story__media { --ul-es-ratio: 4 / 5; }
  .ul-editorial-story--ratio-landscape .ul-editorial-story__media { --ul-es-ratio: 3 / 2; }
  .ul-editorial-story--ratio-square .ul-editorial-story__media { --ul-es-ratio: 1 / 1; }

  .ul-editorial-story__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  .ul-editorial-story__img--placeholder {
    background: rgb(var(--ul-espresso-rgb) / 0.06);
  }

  .ul-editorial-story__text {
    display: flex;
    align-items: center;
    padding-block: clamp(40px, 7vw, 88px);
  }

  .ul-editorial-story__content {
    max-width: 46ch;
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 1.8vw, 24px);
  }

  .ul-editorial-story__eyebrow {
    color: var(--ul-brass);
    display: flex;
    align-items: center;
    gap: 0.9em;
  }

  .ul-editorial-story--dark .ul-editorial-story__eyebrow {
    color: color-mix(in srgb, var(--ul-brass) 80%, white);
  }

  .ul-editorial-story__rule {
    height: 1px;
    flex: 1 1 auto;
    max-width: 56px;
    background: currentcolor;
    opacity: 0.55;
  }

  .ul-editorial-story__heading {
    font-family: var(--ul-font-display);
    font-weight: 700;
    font-size: var(--ul-fs-h2);
    line-height: 1.04;
    letter-spacing: -0.01em;
    margin: 0;
    text-wrap: balance;
  }

  .ul-editorial-story__body {
    font-family: var(--ul-font-body);
    font-size: var(--ul-fs-body);
    line-height: 1.65;
  }

  .ul-editorial-story__body > * { margin: 0; }
  .ul-editorial-story__body > * + * { margin-top: 0.9em; }

  .ul-editorial-story--bone .ul-editorial-story__body { color: rgb(var(--ul-espresso-rgb) / 0.86); }
  .ul-editorial-story--dark .ul-editorial-story__body { color: rgb(var(--ul-bone-rgb) / 0.84); }

  .ul-editorial-story__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: clamp(6px, 1vw, 12px);
  }

  /* Buttons (shared brand button idiom) */
  .ul-editorial-story .ul-btn {
    --ul-btn-bg: var(--ul-brass);
    --ul-btn-fg: var(--ul-espresso);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    min-height: 52px;
    padding: 0 32px;
    border-radius: var(--ul-radius);
    font-family: var(--ul-font-body);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    cursor: pointer;
    border: 1.5px solid transparent;
    background: var(--ul-btn-bg);
    color: var(--ul-btn-fg);
    transition: transform 0.45s var(--ul-ease), background-color 0.35s var(--ul-ease), color 0.35s var(--ul-ease), border-color 0.35s var(--ul-ease);
  }

  .ul-editorial-story .ul-btn:hover { transform: translateY(-2px); }

  .ul-editorial-story .ul-btn--primary {
    --ul-btn-bg: var(--ul-brass);
    --ul-btn-fg: #fff;
  }
  .ul-editorial-story .ul-btn--primary:hover { --ul-btn-bg: color-mix(in srgb, var(--ul-brass) 84%, black); }

  /* Secondary on the bone surface: espresso outline */
  .ul-editorial-story--bone .ul-btn--secondary {
    --ul-btn-bg: transparent;
    --ul-btn-fg: var(--ul-espresso);
    border-color: rgb(var(--ul-espresso-rgb) / 0.4);
  }
  .ul-editorial-story--bone .ul-btn--secondary:hover {
    --ul-btn-bg: var(--ul-espresso);
    --ul-btn-fg: var(--ul-bone);
    border-color: var(--ul-espresso);
  }

  /* Secondary on the dark surface: bone outline */
  .ul-editorial-story--dark .ul-btn--secondary {
    --ul-btn-bg: transparent;
    --ul-btn-fg: var(--ul-bone);
    border-color: rgb(var(--ul-bone-rgb) / 0.55);
  }
  .ul-editorial-story--dark .ul-btn--secondary:hover {
    --ul-btn-bg: var(--ul-bone);
    --ul-btn-fg: var(--ul-espresso);
    border-color: var(--ul-bone);
  }

  .ul-editorial-story .ul-btn:focus-visible {
    outline: 2px solid var(--ul-brass);
    outline-offset: 3px;
  }

  .ul-editorial-story :focus-visible {
    outline-offset: 3px;
  }

  /* Gentle scale-in for the lifestyle image (rides the shared ul-reveal). */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .ul-editorial-story__img.ul-reveal {
        transform: translateY(0) scale(1.04);
        transform-origin: center;
      }
    }
  }

  @media (min-width: 750px) {
    .ul-editorial-story__grid {
      grid-template-columns: 1fr 1fr;
    }

    .ul-editorial-story__media {
      aspect-ratio: auto;
      height: 100%;
    }

    /* Media-right: keep image visually trailing while it stays first in DOM
       (image first on mobile for the editorial reveal). */
    .ul-editorial-story--media-right .ul-editorial-story__media { order: 2; }
    .ul-editorial-story--media-right .ul-editorial-story__text { order: 1; }

    .ul-editorial-story--media-left .ul-editorial-story__text { justify-content: flex-start; }
    .ul-editorial-story--media-right .ul-editorial-story__text { justify-content: flex-end; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "UL Story",
  "tag": "section",
  "class": "ul-editorial-story-section",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "media_position", "label": "Image side (desktop)",
      "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ],
      "default": "left"
    },
    {
      "type": "select", "id": "color_mode", "label": "Color mode",
      "options": [ { "value": "bone", "label": "Bone (light)" }, { "value": "dark", "label": "Dark" } ],
      "default": "bone"
    },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Falls back to the desktop image if empty." },
    { "type": "text", "id": "image_alt", "label": "Image alt text (accessibility)" },
    {
      "type": "select", "id": "image_ratio", "label": "Mobile image shape",
      "info": "Controls the image aspect on mobile (desktop fills the column height).",
      "options": [
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "landscape", "label": "Landscape (3:2)" },
        { "value": "square", "label": "Square (1:1)" }
      ],
      "default": "portrait"
    },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 104 }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Eyebrow", "settings": [ { "type": "text", "id": "text", "label": "Eyebrow" } ] },
    { "type": "heading", "name": "Heading", "settings": [ { "type": "text", "id": "text", "label": "Heading" } ] },
    { "type": "body", "name": "Body text", "settings": [ { "type": "richtext", "id": "text", "label": "Body" } ] },
    {
      "type": "button", "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Button label" },
        { "type": "url", "id": "link", "label": "Button link" },
        {
          "type": "select", "id": "style", "label": "Style",
          "options": [ { "value": "primary", "label": "Primary (brass)" }, { "value": "secondary", "label": "Secondary (outline)" } ],
          "default": "primary"
        },
        { "type": "checkbox", "id": "open_in_new_tab", "label": "Open in new tab", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "UL Story",
      "blocks": [
        { "type": "eyebrow", "settings": { "text": "Why we exist" } },
        { "type": "heading", "settings": { "text": "Together we represent Him" } },
        { "type": "body", "settings": { "text": "<p>Unashamed Living began with a simple conviction: faith was never meant to stay quiet. Every piece we make is a conversation starter — a way to carry the Gospel into everyday rooms with confidence and warmth.</p><p>When you wear it, you're not wearing a brand. You're joining a people who proclaim boldly and give generously, so the light of Christ is seen in each of us.</p>" } },
        { "type": "button", "settings": { "label": "Read our story", "link": "shopify://pages/need-prayer", "style": "secondary" } }
      ],
      "settings": {
        "media_position": "left",
        "color_mode": "bone",
        "image_ratio": "portrait"
      }
    }
  ]
}
{% endschema %}
